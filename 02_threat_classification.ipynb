import pandas as pd
import numpy as np
import os
import joblib
from google.colab import drive
from sklearn.metrics import confusion_matrix, classification_report, precision_score, recall_score, f1_score

# 1. Drive Bağlantısı
if not os.path.exists('/content/drive'):
    drive.mount('/content/drive')

BASE = "/content/drive/MyDrive/SentinelAI"
os.chdir(BASE)
print("✅ Çalışma dizini ayarlandı:", os.getcwd())

# 2. Veriyi Yükle ve Anomali Skorlarını Uygula
print("\n⏳ Veri yükleniyor ve model çalıştırılıyor...")
try:
    df = pd.read_parquet(f"{BASE}/data/processed/logs.parquet")
    artifacts = joblib.load(f"{BASE}/models/isoforest.pkl")
    model = artifacts["model"]
    scaler = artifacts["scaler"]
    features = artifacts["features"]
    
    X = df[features].values
    X_scaled = scaler.transform(X)
    
    df["anomaly"] = model.predict(X_scaled)
    df["anomaly_score"] = -model.score_samples(X_scaled)
    
    df.to_parquet(f"{BASE}/data/processed/logs_with_anomaly.parquet", index=False)
    print(f"✅ {len(df)} satır veri işlendi ve anomali skorları eklendi.")
except Exception as e:
    print(f"❌ Veri yükleme hatası: {e}")
    print("Lütfen önceki notebook'larda veriyi (logs.parquet) oluşturduğunuzdan emin olun.")
    raise

# 3. Kural Tabanlı Sınıflandırma (Zaman Sızıntısı Düzeltildi)
def classify_threat(row):
    attempts   = row["attempts"]
    is_failed  = row["is_failed"]
    is_night   = row["is_night"]
    ip_count   = row["ip_log_count"]
    user_fail  = row["user_failed_count"]
    event      = row["event"]

    if is_failed and attempts >= 20:
        return ("Brute Force", "T1110", f"Aynı oturumda {attempts} başarısız deneme. Brute-force ile uyumlu.")

    if is_failed and attempts >= 10:
        return ("Suspicious Failed Logins", "T1110.001", f"{attempts} başarısız deneme. Password guessing olabilir.")

    # KURAL 3: ZAMAN SIZINTISI ÖNLEYİCİ (Sadece geçmişe bakar)
    if is_night and event == "Login Success":
        gecmis_loglar = df[(df["user"] == row["user"]) & 
                           (df["is_night"] == 1) & 
                           (df["event"] == "Login Success") & 
                           (df["timestamp"] < row["timestamp"])]
        kullanici_gece_giris_sayisi = len(gecmis_loglar)

        if kullanici_gece_giris_sayisi < 20:
            return ("Suspicious Login Time", "T1078", f"Gece {int(row['hour']):02d}:00 civarı giriş. Kullanıcının geçmiş davranışına uymuyor.")

    if user_fail >= 20 and is_failed:
        return ("Targeted Credential Attack", "T1110.003", f"'{row['user']}' kullanıcısına {user_fail} başarısız giriş.")

    if row["anomaly"] == -1:
        return ("Unknown Anomaly", "TBD", "Model anomali işaretledi fakat bilinen bir kurala uymuyor.")

    return ("Normal", None, "Belirgin bir tehdit göstergesi yok.")

print("\n⏳ Kural motoru çalıştırılıyor...")
df[["threat_type", "mitre_id", "reason"]] = df.apply(lambda r: pd.Series(classify_threat(r)), axis=1)
print(" Sınıflandırma tamamlandı.")

# 4. Değerlendirme (Metrikler)
print("\n📊 METRİKLER HESAPLANIYOR...")
df["pred_attack"] = (df["threat_type"] != "Normal").astype(int)
y_true = df["true_label"]
y_pred = df["pred_attack"]

cm = confusion_matrix(y_true, y_pred)
tn, fp, fn, tp = cm.ravel()

print("="*40)
print("KARMAŞIKLIK MATRİSİ")
print(f"TN={tn}  FP={fp}")
print(f"FN={fn}  TP={tp}")
print("-" * 40)
print(f"Precision : {precision_score(y_true, y_pred):.3f}")
print(f"Recall    : {recall_score(y_true, y_pred):.3f}")
print(f"F1-Score  : {f1_score(y_true, y_pred):.3f}")
print("="*40)

# 5. Sonuçları ve Raporu Kaydet
print("\n⏳ Rapor kaydediliyor...")
out_path = f"{BASE}/data/processed/logs_classified.parquet"
df.to_parquet(out_path, index=False)

report = f"""# SentinelAI – Aşama 2: Threat Classification & MITRE Mapping

## Özet
- **Toplam log:** {len(df)}
- **Saldırı olarak işaretlenen:** {(df['threat_type'] != 'Normal').sum()}
- **Normal:** {(df['threat_type'] == 'Normal').sum()}

## Değerlendirme (Gerçek Etikete Göre)
- Precision: {precision_score(y_true, y_pred):.3f}
- Recall: {recall_score(y_true, y_pred):.3f}
- F1: {f1_score(y_true, y_pred):.3f}
- False Positive Oranı: {fp/(fp+tn):.3f}
- False Negative Oranı: {fn/(fn+tp):.3f}

## Notlar
- Temporal leakage (zaman sızıntısı) sorunu `df["timestamp"] < row["timestamp"]` filtresi ile çözülmüştür.
"""
report_path = f"{BASE}/reports/threat_report.md"
os.makedirs(os.path.dirname(report_path), exist_ok=True)
with open(report_path, "w", encoding="utf-8") as f:
    f.write(report)

print(f" Rapor kaydedildi: {report_path}")
print("\n TÜM İŞLEMLER BAŞARIYLA TAMAMLANDI!")
