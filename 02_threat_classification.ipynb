### Hücre 6: Kural Motoru Testleri
```python
import pandas as pd

test_senaryolari = [
    {
        "ad": "Ağır brute-force",
        "row": {"attempts": 35, "is_failed": 1, "is_night": 1,
                "ip_log_count": 100, "user_failed_count": 100,
                "event": "Failed Login", "user": "admin", "hour": 2,
                "anomaly": -1},
        "beklenen": "Brute Force",
    },
    {
        "ad": "Orta seviye fail",
        "row": {"attempts": 12, "is_failed": 1, "is_night": 0,
                "ip_log_count": 50, "user_failed_count": 12,
                "event": "Failed Login", "user": "bob", "hour": 14,
                "anomaly": -1},
        "beklenen": "Suspicious Failed Logins",
    },
    {
        "ad": "Gece başarılı giriş",
        "row": {"attempts": 1, "is_failed": 0, "is_night": 1,
                "ip_log_count": 20, "user_failed_count": 0,
                "event": "Login Success", "user": "test_kullanici_123", "hour": 3,
                "anomaly": -1},
        "beklenen": "Suspicious Login Time",
    },
    {
        "ad": "Normal gündüz giriş",
        "row": {"attempts": 1, "is_failed": 0, "is_night": 0,
                "ip_log_count": 20, "user_failed_count": 0,
                "event": "Login Success", "user": "carol", "hour": 14,
                "anomaly": 1},
        "beklenen": "Normal",
    },
]

print(" Kural Motoru Testleri\n" + "="*60)
gecen = 0
for t in test_senaryolari:
    threat, mitre, reason = classify_threat(pd.Series(t["row"]))
    durum = "✅" if threat == t["beklenen"] else "❌"
    if threat == t["beklenen"]:
        gecen += 1
    print(f"{durum} {t['ad']:25} → {threat:30} (MITRE: {mitre})")
    if threat != t["beklenen"]:
        print(f"    Beklenen: {t['beklenen']} | Gelen: {threat}")

print("="*60)
print(f" Sonuç: {gecen}/{len(test_senaryolari)} test geçti")
```

### Hücre 7: Model Değerlendirmesi (Gerçek Etiketle)
```python
from sklearn.metrics import (
    confusion_matrix, classification_report,
    precision_score, recall_score, f1_score
)

# "Saldırı mı?" → Normal değilse saldırı
df["pred_attack"] = (df["threat_type"] != "Normal").astype(int)

y_true = df["true_label"]
y_pred = df["pred_attack"]

cm = confusion_matrix(y_true, y_pred)
tn, fp, fn, tp = cm.ravel()

print(" KARMAŞIKLIK MATRİSİ")
print(f"   TN={tn}  FP={fp}")
print(f"   FN={fn}  TP={tp}")
print()
print(" METRİKLER (Kural Tabanlı)")
print(f"   Precision : {precision_score(y_true, y_pred):.3f}")
print(f"   Recall    : {recall_score(y_true, y_pred):.3f}")
print(f"   F1        : {f1_score(y_true, y_pred):.3f}")
print(f"   FP oranı  : {fp/(fp+tn):.3f}")
print(f"   FN oranı  : {fn/(fn+tp):.3f}")
print()
print(" Sınıf bazlı rapor:")
print(classification_report(y_true, y_pred, target_names=["Normal", "Attack"], digits=3))
```

### Hücre 8: Sonuçları ve Raporu Kaydet
```python
from sklearn.metrics import precision_score, recall_score, f1_score
import os

# 1. Veriyi kaydet
out_path = f"{BASE}/data/processed/logs_classified.parquet"
df.to_parquet(out_path, index=False)
print(f" Sınıflandırılmış veri: {out_path}")

# 2. MITRE dağılımı
mitre_dist = df[df["mitre_id"].notna()]["mitre_id"].value_counts()

# 3. Markdown raporu
report = f"""# SentinelAI – Aşama 2: Threat Classification & MITRE Mapping

## Özet
- **Toplam log:** {len(df)}
- **Saldırı olarak işaretlenen:** {(df['threat_type'] != 'Normal').sum()}
- **Normal:** {(df['threat_type'] == 'Normal').sum()}

## Tehdit Dağılımı
{df['threat_type'].value_counts().to_markdown()}

## MITRE Dağılımı
{mitre_dist.to_markdown() if not mitre_dist.empty else 'MITRE kaydı bulunmamaktadır.'}

## Değerlendirme (Gerçek Etikete Göre)
- Precision: {precision_score(y_true, y_pred):.3f}
- Recall: {recall_score(y_true, y_pred):.3f}
- F1: {f1_score(y_true, y_pred):.3f}
- False Positive Oranı: {fp/(fp+tn):.3f}
- False Negative Oranı: {fn/(fn+tp):.3f}

## Kural Motoru Öncelik Sırası
1. Ağır brute-force (attempts >= 20 + fail) → T1110
2. Orta seviye fail (attempts >= 10 + fail) → T1110.001
3. Gece başarılı giriş (temporal leakage önleyici zaman filtresi ile) → T1078
4. Hedefli saldırı (user_failed >= 20) → T1110.003
5. Anomali ama kurala uymuyor → TBD
6. Normal
"""

# Raporu kaydet ve yazdır
report_path = f"{BASE}/reports/threat_report.md"
os.makedirs(os.path.dirname(report_path), exist_ok=True)
with open(report_path, "w", encoding="utf-8") as f:
    f.write(report)

print(f" Rapor oluşturuldu ve kaydedildi: {report_path}\n")
print(report)
```
